# Секрет для JWT-сессий (обязательно в production)
AUTH_SECRET=замените-на-длинную-случайную-строку

# Google OAuth — https://console.cloud.google.com/apis/credentials
# Тип: OAuth 2.0 Client ID → Web application
# Authorized JavaScript origins: http://localhost:3000
NEXT_PUBLIC_GOOGLE_CLIENT_ID=ваш-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_ID=ваш-client-id.apps.googleusercontent.com
